{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-generate-quizzes",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-reset-monthly",
      "schedule": "0 0 1 * *"
    }
  ]
}